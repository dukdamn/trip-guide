{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip.schema.json",
  "title": "Trip",
  "description": "여행 한 건의 데이터. MD(trips/*.md)를 변환하거나 AI가 직접 생성한다. 국가 공통 정보는 pack(국가 팩)에 둔다.",
  "type": "object",
  "required": [
    "schemaVersion",
    "meta",
    "days"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "meta": {
      "type": "object",
      "required": [
        "title",
        "startDate",
        "endDate",
        "country",
        "currency",
        "homeCurrency",
        "lang"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "URL용 슬러그. 예: danang-2026"
        },
        "title": {
          "type": "string"
        },
        "badge": {
          "type": "string",
          "description": "헤더 배지. 예: 3박 4일"
        },
        "emoji": {
          "type": "string"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "people": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "country": {
          "type": "string",
          "pattern": "^[a-z]{2}$",
          "description": "ISO 3166-1 alpha-2 소문자. MD에는 '일본', 'Japan', 'jp' 모두 가능 → 변환기가 코드로 바꿈. 국가 팩(packs/<code>.json)은 선택"
        },
        "cities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "homeCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "보는 사람의 통화. 예: KRW, JPY"
        },
        "lang": {
          "type": "string",
          "enum": [
            "ko",
            "ja",
            "en"
          ],
          "description": "UI 언어"
        },
        "rate": {
          "type": "object",
          "description": "현지 통화 1단위 → homeCurrency. 비우면 국가 팩 기본값 사용",
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "현지 통화 1 → homeCurrency"
            },
            "asOf": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "현지 통화. 국가 테이블·팩에서 자동 결정, MD에서 덮어쓰기 가능"
        }
      }
    },
    "flights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dir",
          "date",
          "route"
        ],
        "additionalProperties": false,
        "properties": {
          "dir": {
            "enum": [
              "out",
              "in"
            ],
            "description": "out=가는 편, in=오는 편"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "route": {
            "type": "string",
            "description": "예: 인천 → 다낭"
          },
          "time": {
            "type": "string",
            "description": "예: 22:30~23:30 도착"
          },
          "note": {
            "type": "string"
          },
          "link": {
            "type": "string",
            "format": "uri",
            "description": "구글맵 외 참고 링크 (블로그·인스타·예약 페이지)"
          }
        }
      }
    },
    "stays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "checkIn",
          "checkOut"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          },
          "place": {
            "$ref": "#/$defs/place"
          },
          "link": {
            "type": "string",
            "format": "uri",
            "description": "구글맵 외 참고 링크 (블로그·인스타·예약 페이지)"
          }
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "day",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "day": {
            "type": "integer",
            "minimum": 0
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "label": {
            "type": "string",
            "description": "날짜 버튼에 표시. 예: 시내·밤"
          },
          "city": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "time": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                  "description": "정확한 시간. 모르면 slot 사용"
                },
                "title": {
                  "type": "string"
                },
                "tag": {
                  "$ref": "#/$defs/tag"
                },
                "desc": {
                  "type": "string"
                },
                "transit": {
                  "type": "string",
                  "description": "다음 일정까지 이동. 예: Grab 약 6분 / 2.3km"
                },
                "place": {
                  "$ref": "#/$defs/place"
                },
                "slot": {
                  "enum": [
                    "dawn",
                    "morning",
                    "noon",
                    "afternoon",
                    "evening",
                    "night"
                  ],
                  "description": "대략적인 시간대 (MD: '오후: 제목')"
                },
                "link": {
                  "type": "string",
                  "format": "uri",
                  "description": "구글맵 외 참고 링크 (블로그·인스타·예약 페이지)"
                }
              }
            }
          }
        }
      }
    },
    "places": {
      "type": "array",
      "description": "맛집·놀거리 목록",
      "items": {
        "type": "object",
        "required": [
          "type",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "do",
              "food",
              "cafe",
              "night",
              "shop",
              "care"
            ]
          },
          "area": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "예: 임시휴업"
          },
          "plan": {
            "type": "integer",
            "minimum": 0,
            "description": "일정에 포함된 day 번호"
          },
          "place": {
            "$ref": "#/$defs/place"
          },
          "link": {
            "type": "string",
            "format": "uri",
            "description": "구글맵 외 참고 링크 (블로그·인스타·예약 페이지)"
          }
        }
      }
    },
    "dishes": {
      "type": "array",
      "description": "먹어볼 것 체크리스트",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "place": {
            "$ref": "#/$defs/place"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "basis",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "perPerson",
            "group"
          ],
          "description": "섹션 기본값. 항목별 basis가 있으면 그게 우선"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cat",
              "name",
              "amount"
            ],
            "additionalProperties": false,
            "properties": {
              "cat": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "description": "금액 (기본: 현지 통화)"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "현지 통화가 아닐 때만 (예: 원화로 적은 항목)"
              },
              "basis": {
                "enum": [
                  "perPerson",
                  "group"
                ],
                "description": "1인 기준 / 전체(공동) 기준. 화면은 people로 1인↔전체 환산"
              }
            }
          }
        }
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "이 여행만의 팁. 국가 팩 팁 위에 표시"
    },
    "checklist": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkGroup"
      },
      "description": "준비물"
    }
  },
  "$defs": {
    "tag": {
      "enum": [
        "booked",
        "option",
        "tbd",
        "free"
      ],
      "description": "MD: #예약 #옵션 #미정 #자유 (영·일 가능)"
    },
    "place": {
      "type": "object",
      "description": "지도 정보. MD에는 구글맵 링크를 붙여넣으면 된다. 링크에 좌표가 있으면 lat/lng 자동 추출, 짧은 링크는 --resolve로 채움",
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "q"
          ]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "구글맵 링크 (공유 링크 maps.app.goo.gl, 장소 URL, 검색 URL 모두 가능)"
        },
        "q": {
          "type": "string",
          "description": "장소명/검색어 (링크에서 추출되거나 @검색어로 입력)"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "checkGroup": {
      "type": "object",
      "required": [
        "group",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}